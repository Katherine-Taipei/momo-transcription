<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Momo.App.ViewModels"
        xmlns:controls="using:Momo.App.Controls"
        xmlns:converters="using:Momo.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
        x:Class="Momo.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Momo Local AI Transcription Dashboard"
        Width="1050" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#12131C"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </Window.Resources>

    <Grid ColumnDefinitions="240, *, Auto">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1A1C29" BorderBrush="#25273C" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                <!-- Header Logo -->
                <StackPanel Grid.Row="0" Spacing="10" Margin="0,10,0,30">
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Grid.Column="0" Source="{Binding LogoBitmap}" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MOMO" FontSize="22" FontWeight="Black" Foreground="#8B5CF6" LetterSpacing="2"/>
                            <TextBlock Text="Enterprise Platform" FontSize="10" Foreground="#6D7090"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Project Quick Links -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <Button Content="Queue Dashboard" Background="#26283C" Foreground="White" HorizontalAlignment="Stretch" Padding="12" CornerRadius="8"/>
                    <Button Content="Local Files" Background="Transparent" Foreground="#6D7090" HorizontalAlignment="Stretch" Padding="12" CornerRadius="8"/>
                    <Button Content="Export Templates" Background="Transparent" Foreground="#6D7090" HorizontalAlignment="Stretch" Padding="12" CornerRadius="8"/>
                </StackPanel>

                <!-- Footer Profile & Theme Switcher -->
                <StackPanel Grid.Row="2" Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="System Mode:" FontSize="10" Foreground="#6D7090"/>
                        <TextBlock Text="Laptop Safe Mode (CPU)" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Theme:" FontSize="10" Foreground="#6D7090"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemeSetting}" HorizontalAlignment="Stretch" CornerRadius="6" Background="#26283C" Foreground="White" BorderBrush="#25273C"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabbed Dashboard View -->
        <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="15">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#6D7090"/>
                    <Setter Property="Padding" Value="15,10"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#8B5CF6"/>
                </Style>
            </TabControl.Styles>

            <!-- Tab 1: Queue Manager -->
            <TabItem Header="Queue Dashboard">
                <Grid RowDefinitions="Auto, *, Auto" Margin="10,20,10,10">
                    <!-- Top Action Ingester -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Transcription Queue Manager" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Stage 1 Minimum Stable Baseline" FontSize="12" Foreground="#6D7090"/>
                        </StackPanel>
                        
                        <!-- Import Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="FilePathTextBox" Watermark="Enter audio file path..." Width="180" VerticalAlignment="Center" CornerRadius="8" Background="#1A1C29" BorderBrush="#25273C" Foreground="White"/>
                            <CheckBox Content="Speaker Diarization" IsChecked="{Binding IsDiarizationEnabled}" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
                            <CheckBox Content="Word Alignment" IsChecked="{Binding IsAlignmentEnabled}" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="Import &amp; Enqueue" Command="{Binding ImportCommand}" CommandParameter="{Binding #FilePathTextBox.Text}" Background="#8B5CF6" Foreground="White" Padding="10,8" CornerRadius="8" FontWeight="SemiBold"/>
                            <Button Content="⚙" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Copilot Settings" Background="#26283C" Foreground="White" Padding="10,8" CornerRadius="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Jobs Queue Data Grid -->
                    <Border Grid.Row="1" Background="#1A1C29" CornerRadius="12" BorderBrush="#25273C" BorderThickness="1" Padding="15">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Job Queue Tasks" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" RowHeight="45" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job ID" Binding="{Binding Id}" Width="150"/>
                                    <DataGridTextColumn Header="Media File" Binding="{Binding MediaFile.FilePath}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                                    <DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Bottom Progress & Action Controls -->
                    <Border Grid.Row="2" Margin="0,20,0,0" Background="#1A1C29" CornerRadius="12" BorderBrush="#25273C" BorderThickness="1" Padding="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Progress Metrics -->
                            <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="White" FontWeight="SemiBold"/>
                                <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Foreground="#8B5CF6" Background="#26283C" Width="450" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Control Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Content="Pause" Command="{Binding PauseCommand}" Background="#F59E0B" Foreground="White" Padding="15,8" CornerRadius="8"/>
                                <Button Content="Resume" Command="{Binding ResumeCommand}" Background="#10B981" Foreground="White" Padding="15,8" CornerRadius="8"/>
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Background="#EF4444" Foreground="White" Padding="15,8" CornerRadius="8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Workspace -->
            <TabItem Header="Workspace" IsEnabled="{Binding IsWorkspaceEnabled}">
                <Grid RowDefinitions="Auto, *" Margin="10,20,10,10">
                    <!-- Speaker Timeline Custom Control -->
                    <controls:SpeakerTimeline Grid.Row="0"
                        Height="55"
                        Margin="0,0,0,15"
                        Segments="{Binding CurrentSegments}"
                        CurrentTime="{Binding CurrentTime, Mode=TwoWay}"
                        Duration="{Binding Duration}"/>

                    <!-- Workspace Detail Panels (Split Editor & Glossary Tags) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, 15, 280">
                        <!-- Transcript Paragraphs List (Left) -->
                        <Border Grid.Column="0" Background="#1A1C29" CornerRadius="12" BorderBrush="#25273C" BorderThickness="1" Padding="15">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Transcript Editor" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                <ScrollViewer Grid.Row="1" x:Name="ParagraphScrollViewer">
                                    <ItemsControl ItemsSource="{Binding CurrentParagraphs}" x:Name="ParagraphsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#25273C" BorderThickness="1">
                                                    <Border.Styles>
                                                        <Style Selector="Border">
                                                            <Setter Property="Background" Value="#151722"/>
                                                        </Style>
                                                        <Style Selector="Border[Tag=True]">
                                                            <Setter Property="Background" Value="#2E234A"/>
                                                            <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <Border.Tag>
                                                        <Binding Path="IsHighlighted"/>
                                                    </Border.Tag>
                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <StackPanel Grid.Column="0" Width="100" Margin="0,0,10,0" Spacing="4">
                                                            <TextBlock Text="{Binding Speaker}" FontWeight="Bold" Foreground="#8B5CF6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TimestampText}" Foreground="#6D7090" FontSize="10"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBox Text="{Binding Text, Mode=TwoWay}" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" AcceptsReturn="True"
                                                                     KeyUp="TextBox_KeyUp"
                                                                     PointerReleased="TextBox_PointerReleased"/>
                                                            <TextBlock Text="{Binding PresenceText}" Foreground="#34D399" FontSize="10" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Search & Tag Cloud Sidebar Panel (Right) -->
                        <Border Grid.Column="2" Background="#1A1C29" CornerRadius="12" BorderBrush="#25273C" BorderThickness="1" Padding="15">
                            <Grid RowDefinitions="Auto, Auto, 180, 15, Auto, *">
                                <!-- Search Header -->
                                <TextBlock Grid.Row="0" Text="Search Transcript (Ctrl+F)" FontSize="14" FontWeight="SemiBold" Foreground="#8B5CF6" Margin="0,0,0,10"/>
                                <!-- Search Input & Nav Buttons -->
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
                                    <TextBox Grid.Column="0" x:Name="SearchTextBox" Watermark="Search keyword..." Text="{Binding SearchQuery, Mode=TwoWay}" CornerRadius="8" Background="#12131C" Foreground="White" BorderBrush="#25273C" Height="32" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="◀" Command="{Binding PrevMatchCommand}" ToolTip.Tip="Previous Match" Background="#25273C" Foreground="White" Width="30" Height="32" CornerRadius="8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                                    <Button Grid.Column="2" Content="▶" Command="{Binding NextMatchCommand}" ToolTip.Tip="Next Match" Background="#25273C" Foreground="White" Width="30" Height="32" CornerRadius="8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <!-- Search Results List -->
                                <ScrollViewer Grid.Row="2">
                                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#25273C" BorderThickness="0,0,0,1" Padding="4">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Context}" TextWrapping="Wrap" FontSize="11" Foreground="White"/>
                                                        <TextBlock Text="{Binding ParagraphIndex, StringFormat='Paragraph {0}'}" FontSize="10" Foreground="#6D7090"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                                
                                <!-- Separator -->
                                <Rectangle Grid.Row="3" Height="1" Fill="#25273C" Margin="0,5"/>
                                
                                <!-- Tag Cloud Header -->
                                <TextBlock Grid.Row="4" Text="Domain Glossary Tags" FontSize="14" FontWeight="SemiBold" Foreground="#8B5CF6" Margin="0,5,0,10"/>
                                <!-- Tag Cloud ScrollViewer -->
                                <ScrollViewer Grid.Row="5">
                                    <ItemsControl ItemsSource="{Binding TagCloudItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Margin="5"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Term}"
                                                        Command="{Binding $parent[Window].DataContext.SelectTagCommand}"
                                                        CommandParameter="{Binding Term}"
                                                        FontSize="{Binding FontSize}"
                                                        Foreground="{Binding ColorHex}"
                                                        Margin="4"
                                                        Padding="8,4"
                                                        CornerRadius="6"
                                                        ToolTip.Tip="{Binding Count, StringFormat='Occurrences: {0}'}">
                                                    <Button.Styles>
                                                        <Style Selector="Button">
                                                            <Setter Property="Background" Value="#25273C"/>
                                                        </Style>
                                                        <Style Selector="Button:hover">
                                                            <Setter Property="Background" Value="#8B5CF6"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Version History & Diff -->
            <TabItem Header="Version History" IsEnabled="{Binding IsWorkspaceEnabled}">
                <Grid ColumnDefinitions="300, 15, *" Margin="10,20,10,10">
                    <!-- Left Panel: Version Tree Timeline -->
                    <Border Grid.Column="0" Background="#1A1C29" CornerRadius="12" BorderBrush="#25273C" BorderThickness="1" Padding="15">
                        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                            <TextBlock Grid.Row="0" Text="Version History Tree" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            
                            <!-- Search filter -->
                            <TextBox Grid.Row="1" Text="{Binding RevisionSearchText, Mode=TwoWay}" Watermark="Search versions..." Background="#12131C" BorderBrush="#25273C" Foreground="White" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"/>
                            
                            <!-- Autosave filter -->
                            <CheckBox Grid.Row="2" Content="Show Autosaves" IsChecked="{Binding ShowAutosaves, Mode=TwoWay}" Foreground="#6D7090" FontSize="11" Margin="0,0,0,15"/>

                            <!-- Versions List -->
                            <ScrollViewer Grid.Row="3">
                                <ListBox x:Name="RevisionListBox" ItemsSource="{Binding FilteredRevisions}" SelectedItem="{Binding SelectedRevision}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="10" Margin="0,0,0,8" Background="#151722" BorderBrush="#25273C" BorderThickness="1">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding VersionNumber, StringFormat='Version {0}'}" FontWeight="Bold" Foreground="#8B5CF6" FontSize="12"/>
                                                        <!-- Status Badge -->
                                                        <Border Grid.Column="1" CornerRadius="4" Padding="5,2" Margin="4,0" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding CreatedBy}" Foreground="#34D399" FontSize="10" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="#6D7090" FontSize="10"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>

                            <!-- Batch Actions Footer -->
                            <StackPanel Grid.Row="4" Orientation="Vertical" Spacing="6" Margin="0,12,0,0">
                                <TextBlock Text="Batch Actions (All Pending)" Foreground="#6D7090" FontSize="10" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*, 8, *">
                                    <Button x:Name="BatchAcceptButton" Grid.Column="0"
                                            Content="✓ Accept All"
                                            Command="{Binding BatchAcceptCommand}"
                                            Background="#065F46" Foreground="#34D399"
                                            Padding="8,6" CornerRadius="6" FontSize="11" FontWeight="SemiBold"
                                            ToolTip.Tip="Accept all pending revisions. This action cannot be undone."/>
                                    <Button x:Name="BatchRejectButton" Grid.Column="2"
                                            Content="✗ Reject All"
                                            Command="{Binding BatchRejectCommand}"
                                            Background="#7F1D1D" Foreground="#F87171"
                                            Padding="8,6" CornerRadius="6" FontSize="11" FontWeight="SemiBold"
                                            ToolTip.Tip="Reject all pending revisions and roll back. This action cannot be undone."/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Panel: Side-by-Side Diff Panel -->
                    <Border Grid.Column="2" Background="#1A1C29" CornerRadius="12" BorderBrush="#25273C" BorderThickness="1" Padding="15">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Diff Header Actions -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                                <TextBlock Grid.Column="0" Text="Side-by-Side Version Diff" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                
                                <!-- Action Buttons row -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <!-- Granularity -->
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="Granularity:" Foreground="#6D7090" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding DiffGranularityOptions}" SelectedItem="{Binding DiffGranularity}" Width="90" Height="32" Background="#12131C" BorderBrush="#25273C" Foreground="White"/>
                                    </StackPanel>
                                    <!-- Accept Revision -->
                                    <Button x:Name="AcceptRevisionButton"
                                            Content="✓ Accept"
                                            Command="{Binding AcceptRevisionCommand}"
                                            IsEnabled="{Binding !!SelectedRevision}"
                                            Background="#065F46" Foreground="#34D399"
                                            Padding="12,6" CornerRadius="8" FontWeight="SemiBold" FontSize="12"
                                            ToolTip.Tip="Accept the selected revision"/>
                                    <!-- Reject Revision -->
                                    <Button x:Name="RejectRevisionButton"
                                            Content="✗ Reject"
                                            Command="{Binding RejectRevisionCommand}"
                                            IsEnabled="{Binding !!SelectedRevision}"
                                            Background="#7F1D1D" Foreground="#F87171"
                                            Padding="12,6" CornerRadius="8" FontWeight="SemiBold" FontSize="12"
                                            ToolTip.Tip="Reject the selected revision (rolls back transcript)"/>
                                    <!-- Rollback Button -->
                                    <Button x:Name="RollbackButton"
                                            Content="↩ Rollback"
                                            Command="{Binding RollbackCommand}"
                                            IsEnabled="{Binding !!SelectedRevision}"
                                            Background="#EF4444" Foreground="White"
                                            Padding="12,6" CornerRadius="8" FontWeight="SemiBold" FontSize="12"
                                            ToolTip.Tip="Roll back to this selected version"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dual Pane Diff Viewer -->
                            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                                <!-- Pane Headers -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, 10, *" Margin="0,0,0,5">
                                    <TextBlock Grid.Column="0" Text="Active Version" Foreground="#6D7090" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Selected Version Snapshot" Foreground="#6D7090" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                </Grid>

                                <!-- Scrolling Diff Rows -->
                                <ScrollViewer Grid.Row="1">
                                    <ListBox ItemsSource="{Binding DiffRows}" Background="Transparent" BorderThickness="0">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0,2"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*, 10, *">
                                                    <!-- Left Pane (Active) -->
                                                    <Border Grid.Column="0" Background="{Binding OldBackground}" CornerRadius="4" Padding="8,6">
                                                        <TextBlock Text="{Binding OldText}" Foreground="{Binding OldForeground}" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas,Monospace"/>
                                                    </Border>
                                                    
                                                    <!-- Divider -->
                                                    <Border Grid.Column="1" Width="1" Background="#25273C" Margin="0,2"/>

                                                    <!-- Right Pane (Selected Revision) -->
                                                    <Border Grid.Column="2" Background="{Binding NewBackground}" CornerRadius="4" Padding="8,6">
                                                        <TextBlock Text="{Binding NewText}" Foreground="{Binding NewForeground}" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas,Monospace"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Right Settings Sidebar Panel -->
        <Border Grid.Column="2" Width="260" Background="#1A1C29" BorderBrush="#25273C" BorderThickness="1,0,0,0" IsVisible="{Binding IsSettingsVisible}">
            <ScrollViewer>
                <StackPanel Margin="20" Spacing="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Copilot Settings" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Command="{Binding ToggleSettingsCommand}" Background="Transparent" Foreground="#6D7090" Padding="5" FontSize="14"/>
                    </Grid>
                    
                    <Separator Background="#25273C" Height="1"/>

                    <!-- Domain Glossary Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Domain Glossaries" FontSize="13" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                        <ItemsControl ItemsSource="{Binding GlossaryOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="White" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Separator Background="#25273C" Height="1"/>

                    <!-- Role Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="VC Analysis Role" FontSize="13" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                        <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" HorizontalAlignment="Stretch" Background="#12131C" BorderBrush="#25273C" Foreground="White"/>
                    </StackPanel>

                    <Separator Background="#25273C" Height="1"/>

                    <!-- Template Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ExportTemplateLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                        <ComboBox ItemsSource="{Binding TemplateOptions}" SelectedItem="{Binding SelectedTemplate}" HorizontalAlignment="Stretch" Background="#12131C" BorderBrush="#25273C" Foreground="White"/>
                    </StackPanel>

                    <Separator Background="#25273C" Height="1"/>

                    <!-- Language Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding LanguageLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch" Background="#12131C" BorderBrush="#25273C" Foreground="White"/>
                    </StackPanel>

                    <Separator Background="#25273C" Height="1"/>

                    <!-- Updates Settings -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SoftwareUpdatesLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding UpdateChannelLabel}" FontSize="10" Foreground="#6D7090"/>
                            <ComboBox ItemsSource="{Binding UpdateChannelOptions}" SelectedItem="{Binding SelectedUpdateChannel}" HorizontalAlignment="Stretch" Background="#12131C" BorderBrush="#25273C" Foreground="White"/>
                            <TextBlock Text="{Binding CheckFrequencyLabel}" FontSize="10" Foreground="#6D7090" Margin="0,5,0,0"/>
                            <ComboBox ItemsSource="{Binding UpdateFrequencyOptions}" SelectedItem="{Binding SelectedUpdateFrequency}" HorizontalAlignment="Stretch" Background="#12131C" BorderBrush="#25273C" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#25273C" Height="1"/>

                    <!-- Telemetry Settings -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding TelemetryPrivacyLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                        <CheckBox Content="{Binding AnonymousTelemetryLabel}" IsChecked="{Binding IsTelemetryEnabled}" Foreground="White" Margin="0,2"/>
                        <Button Content="{Binding LearnMoreLabel}" Command="{Binding OpenGdprPolicyCommand}" Background="Transparent" Foreground="#8B5CF6" Padding="0" BorderThickness="0" FontSize="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- GDPR / Telemetry Opt-in Modal Overlay -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#B010111A" ZIndex="100" IsVisible="{Binding IsTelemetryModalVisible}">
            <Border Background="#1A1C29" BorderBrush="#25273C" BorderThickness="1" CornerRadius="12" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="{Binding TelemetryModalTitle}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TelemetryModalMessage}" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="18"/>
                    <Button Content="{Binding LearnMoreLabel}" Command="{Binding OpenGdprPolicyCommand}" Background="Transparent" Foreground="#8B5CF6" Padding="0" BorderThickness="0" FontSize="11" HorizontalAlignment="Center" Margin="0,5"/>
                    <Grid ColumnDefinitions="*, 8, *, 8, *">
                        <Button Grid.Column="0" Content="{Binding AgreeText}" Command="{Binding TelemetryAgreeCommand}" Background="#0F9F5A" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10,8"/>
                        <Button Grid.Column="2" Content="{Binding DisagreeText}" Command="{Binding TelemetryDisagreeCommand}" Background="#7F1D1D" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10,8"/>
                        <Button Grid.Column="4" Content="{Binding DecideLaterText}" Command="{Binding TelemetryDecideLaterCommand}" Background="#25273C" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10,8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Update Available Modal Overlay -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#B010111A" ZIndex="99" IsVisible="{Binding IsUpdateModalVisible}">
            <Border Background="#1A1C29" BorderBrush="#25273C" BorderThickness="1" CornerRadius="12" Width="520" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,15">
                        <TextBlock Text="{Binding UpdateModalTitle}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding UpdateModalSubTitle}" FontSize="11" Foreground="#6D7090"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" Background="#12131C" CornerRadius="8" BorderBrush="#25273C" BorderThickness="1" Padding="12" Margin="0,0,0,15">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding RenderedMarkdownControls}" Margin="0"/>
                        </ScrollViewer>
                    </Border>
                    
                    <Grid Grid.Row="2" ColumnDefinitions="*, 10, *">
                        <Grid Grid.Column="0">
                            <Button Content="{Binding InstallNowText}" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding !IsInstallingUpdate}" IsVisible="{Binding !IsInstallingUpdate}" Background="#8B5CF6" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10,8" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsInstallingUpdate}">
                                <ProgressBar IsIndeterminate="True" Width="20" Height="20" VerticalAlignment="Center" Foreground="#8B5CF6"/>
                                <TextBlock Text="Installing..." FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Button Grid.Column="2" Content="{Binding RemindMeLaterText}" Command="{Binding RemindUpdateLaterCommand}" IsEnabled="{Binding !IsInstallingUpdate}" Background="#25273C" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10,8"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
